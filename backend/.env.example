# Generate a strong key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Leave blank to use SQLite, or set a PostgreSQL URL (Railway provides this automatically)
DATABASE_URL=

# Set automatically by Railway — leave blank locally
PORT=8000

# Path to the model file inside the container (set in Dockerfile)
MODEL_PATH=/app/only PolyDb.pt
